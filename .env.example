# URL pública del backend Spring Boot, sin barra final.
VITE_API_BASE_URL=http://localhost:8080

# URL de evaluation-query-api (explicaciones, recomendaciones e historial), sin barra final.
VITE_EVALUATION_QUERY_BASE_URL=http://localhost:8082

# URL del backend de autenticación (Security-Module), sin barra final. Si se
# omite, el login funciona en modo demostración (sesión simulada en el navegador).
VITE_AUTH_BASE_URL=http://localhost:8081

# Scoring requiere JWT y su CORS ya permite Authorization.
VITE_SCORING_SENDS_TOKEN=true
