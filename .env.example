# URL pública del backend Spring Boot, sin barra final.
VITE_API_BASE_URL=http://localhost:8080

# Enviar el JWT también al Motor de Scoring. Dejar en false mientras scoring
# responda permitAll() y su CORS no incluya `Authorization` en allowedHeaders:
# con true, el navegador bloquea el preflight de TODAS las llamadas a scoring.
VITE_SCORING_SENDS_TOKEN=false
