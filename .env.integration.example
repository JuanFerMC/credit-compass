# Entorno local de integración. No uses estas credenciales en producción.
POSTGRES_DB=CreditsCore
POSTGRES_USER=postgres
POSTGRES_PASSWORD=LocalOnly-ChangeThis-32Chars-Minimum
POSTGRES_PORT=5433

# Primer administrador local de Auth. Cámbiala antes del primer arranque.
INIT_ADMIN_EMAIL=admin@example.local
INIT_ADMIN_PASSWORD=ChangeThis-Long-Local-Password-123
INIT_ADMIN_NOMBRE=Administrador local

# Par S1 independiente del par JWT de Auth. El nombre debe coincidir con los PEM.
SCORING_SERVICE_JWT_KEY_ID=dev-local
SCORING_SAGA_KEYS_DIR=C:/Users/Juan Mona/Documents/Codex/.local-secrets/veridica/saga

# Estas URLs las usa el navegador, por eso apuntan al host y no a los nombres DNS de Compose.
VITE_API_BASE_URL=http://localhost:8080
VITE_AUTH_BASE_URL=http://localhost:8081
VITE_EVALUATION_QUERY_BASE_URL=http://localhost:8082
VITE_SCORING_SENDS_TOKEN=true
